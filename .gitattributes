# Force LF line endings for shell scripts (cross-platform safety)
*.sh text eol=lf
*.bash text eol=lf

# Windows scripts keep CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Text files
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf

# EditorConfig and dotfiles
.editorconfig text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.shellcheckrc text eol=lf
