# OpenClaw Docker — Environment Variables
# Copy to .env and fill in your values
# NEVER commit .env to version control

# === Model Provider API Key (at least one required) ===
# Anthropic (Claude)
#ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (GPT-4o)
#OPENAI_API_KEY=sk-...

# Google (Gemini)
#GOOGLE_API_KEY=AIza...

# OpenRouter (multi-provider proxy)
#OPENROUTER_API_KEY=sk-or-...

# Local via Ollama (no key needed — set model in openclaw.json)
#OLLAMA_HOST=http://host.docker.internal:11434

# === GitHub (optional — for git operations) ===
#GITHUB_TOKEN=ghp_...

# === Gateway ===
# Auto-generated by setup — retrieve with:
# docker compose run --rm openclaw openclaw dashboard --no-open
#OPENCLAW_GATEWAY_TOKEN=

# === Advanced ===
#OPENCLAW_LOG_LEVEL=info
#OPENCLAW_SANDBOX=false
